# Amazon PA-API 5.0 — https://webservices.amazon.com/paapi5/documentation/
AMAZON_PAAPI_ACCESS_KEY=your_key_here
AMAZON_PAAPI_SECRET_KEY=your_key_here
AMAZON_PARTNER_TAG=your_tag_here

# AliExpress Affiliate — https://open.aliexpress.com/ (clés) + https://portals.aliexpress.com/ (Tracking ID)
# 1. Crée un compte AliExpress, inscris-toi sur Portals (affilié) → crée un Tracking ID
# 2. Sur Open Platform : compte développeur → App Management → Create App (type "Affiliate API", ~2 j ouvrés)
# 3. Renseigne App Key + App Secret + Tracking ID ci-dessous, puis `pnpm fetch`
ALIEXPRESS_APP_KEY=your_key_here
ALIEXPRESS_APP_SECRET=your_key_here
ALIEXPRESS_TRACKING_ID=your_tracking_id_here
# Optionnels :
# ALIEXPRESS_API_GATEWAY=https://api-sg.aliexpress.com/router/rest
# ALIEXPRESS_COUNTRY=FR
